# Telegram Bot Token — get this from @BotFather on Telegram
# REPLACE with your real token before deploying
BOT_TOKEN=your_bot_token_here

# Webhook secret — set this to a random string (e.g. openssl rand -hex 32)
# MUST match the WEBHOOK_SECRET you set in Vercel Environment Variables
WEBHOOK_SECRET=your_random_webhook_secret_here
